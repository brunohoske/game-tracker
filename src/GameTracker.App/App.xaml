<Application x:Class="GameTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameTracker.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:ImagePathConverter x:Key="ImagePath" />
            <conv:VisibleWhenConverter x:Key="VisibleWhen" />
            <conv:TitleToBrushConverter x:Key="TitleBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
