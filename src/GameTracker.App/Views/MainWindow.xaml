<Window x:Class="GameTracker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GameTracker.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="GameTracker"
        Icon="/Assets/app.ico"
        Width="1320" Height="840" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Maximized borderless windows overflow the screen by the frame size: compensate. -->
    <Border x:Name="RootBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header / title bar ============ -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Orientation="Horizontal" Margin="20,0,28,0" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentGradientBrush}">
                            <Grid>
                                <Ellipse Width="18" Height="18" Stroke="White" StrokeThickness="2.2" Margin="0,1,0,0" />
                                <Path Data="M 0,0 L 7,4.5 L 0,9 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,1,0,0" />
                            </Grid>
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="17">
                            <Run Text="GAME" Foreground="{StaticResource TextBrush}" /><Run Text="TRACKER" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Navigation -->
                    <ListBox Grid.Column="1" Style="{StaticResource NavTabs}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                             WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Left">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Actions + caption buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Configurações" AutomationProperties.Name="Configurações" Margin="0,12,12,0"
                                VerticalAlignment="Top" Command="{Binding OpenSettingsCommand}" />
                        <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="0,20,4,0" VerticalAlignment="Top" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar" AutomationProperties.Name="Minimizar" Click="OnMinimize" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar" AutomationProperties.Name="Maximizar" Click="OnMaximize" />
                        <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Fechar para a bandeja" AutomationProperties.Name="Fechar" Click="OnClose" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Page ============ -->
            <ContentControl Grid.Row="1" Content="{Binding SelectedTab.Page}" Focusable="False" />

            <!-- ============ Modal overlay ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Visibility="{Binding Overlay.Content, Converter={StaticResource VisibleWhen}}">
                <Border Background="{StaticResource OverlayBrush}" MouseLeftButtonDown="OnOverlayBackgroundClick" />
                <ContentControl Content="{Binding Overlay.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
