<UserControl x:Class="GameTracker.App.Views.MonthDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GameTracker.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MonthDetailViewModel}"
             d:DesignWidth="1280" d:DesignHeight="800">

    <UserControl.InputBindings>
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="36,22,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Button Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="-10,0,0,8" ToolTip="Voltar (Alt+←)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Cápsula do tempo" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
        </StackPanel>

        <!-- Month statistics -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stats}" Margin="0,18,-14,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StatItem}">
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Label}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Value}" Margin="0,8,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2" Text="RANKING DO MÊS" Style="{StaticResource SectionTitleText}" Margin="0,26,0,10" />

        <!-- Full ranking: virtualized, so a month with hundreds of games stays light -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Games}" Focusable="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,0,24">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RankedGameViewModel}">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Rank" Text="{Binding RankText}" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="18" Foreground="{StaticResource TextDimBrush}" />

                            <Grid Grid.Column="1" Width="42" Height="56">
                                <Border CornerRadius="6" Background="{Binding Name, Converter={StaticResource TitleBrush}}">
                                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                               Foreground="#50FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource ImagePath}, ConverterParameter=84}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2" Margin="16,0,24,0" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,110,0" />
                                    <TextBlock Text="{Binding SessionsText}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextDimBrush}" />
                                </Grid>
                                <Grid Height="6" Margin="0,9,0,0">
                                    <Border CornerRadius="3" Background="{StaticResource SurfaceHoverBrush}" />
                                    <Border CornerRadius="3" Background="{StaticResource AccentGradientBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding BarRatio}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PlaytimeText}" HorizontalAlignment="Right" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding ShareText}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPodium}" Value="True">
                            <Setter TargetName="Rank" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
