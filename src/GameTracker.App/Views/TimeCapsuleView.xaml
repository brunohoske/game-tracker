<UserControl x:Class="GameTracker.App.Views.TimeCapsuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GameTracker.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TimeCapsuleViewModel}"
             d:DesignWidth="1280" d:DesignHeight="800"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Year separator -->
        <DataTemplate DataType="{x:Type vm:YearHeaderViewModel}">
            <Grid Margin="0,18,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="34" Foreground="{StaticResource TextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="16,0,0,7" VerticalAlignment="Bottom" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Border Grid.Column="2" Height="1" Margin="20,0,0,10" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Month card -->
        <DataTemplate DataType="{x:Type vm:MonthRecapViewModel}">
            <Grid Margin="0,0,0,16" MinHeight="200">
                <!-- Featured artwork fading into the card -->
                <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                <Border CornerRadius="14" Margin="1" Opacity="0.22">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding BackgroundPath, Converter={StaticResource ImagePath}, ConverterParameter=480}"
                                    Stretch="UniformToFill" AlignmentX="Right" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="14" Margin="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.15" Color="{StaticResource SurfaceColor}" />
                            <GradientStop Offset="1" Color="#0014161C" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Month summary -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MonthName}" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource TextBrush}" />
                                <Border Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="9" Padding="8,2" Background="{StaticResource AccentSoftBrush}"
                                        Visibility="{Binding IsRecord, Converter={StaticResource VisibleWhen}}" ToolTip="Mês com mais tempo de jogo">
                                    <TextBlock Text="★ RECORDE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <Border Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="9" Padding="8,2" Background="{StaticResource SuccessSoftBrush}"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="EM ANDAMENTO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalText}" Margin="0,6,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="32"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="Trend" Text="{Binding TrendText}" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                       Visibility="{Binding TrendText, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="0,14,0,0" CommandParameter="{Binding}"
                                Command="{Binding DataContext.OpenMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ViewFullText}" />
                                <TextBlock Text="&#xE72A;" Style="{StaticResource IconText}" FontSize="11" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- Top games (preview only) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ItemsControl ItemsSource="{Binding TopGames}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecapGameViewModel}">
                                    <StackPanel Width="104" Margin="0,0,14,0" ToolTip="{Binding Name}">
                                        <Grid Height="138">
                                            <Border CornerRadius="9" Background="{Binding Name, Converter={StaticResource TitleBrush}}">
                                                <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                                                           Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border CornerRadius="9">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource ImagePath}, ConverterParameter=208}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Border x:Name="Frame" CornerRadius="9" BorderThickness="1" BorderBrush="#1FFFFFFF" />
                                            <Border x:Name="Crown" CornerRadius="8" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" ToolTip="Jogo do mês">
                                                <TextBlock Text="★" FontSize="10" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Margin="1,7,1,0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding PlaytimeText}" Margin="1,1,1,0" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFeatured}" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="Crown" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- "+N" opens the full month -->
                        <Button Width="104" Height="138" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" Padding="0"
                                HorizontalContentAlignment="Center" ToolTip="{Binding ViewFullText}"
                                Visibility="{Binding MoreCount, Converter={StaticResource VisibleWhen}}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.OpenMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <StackPanel>
                                <TextBlock Text="{Binding MoreText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="jogos" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTrendUp}" Value="True">
                    <Setter TargetName="Trend" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ============ Timeline ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <StackPanel Margin="36,28,36,28">
                <TextBlock Text="Cápsula do tempo" Style="{StaticResource TitleText}" />
                <TextBlock Text="Tudo o que você jogou, mês a mês." Style="{StaticResource MutedText}" Margin="0,2,0,8" />

                <ItemsControl ItemsSource="{Binding Timeline}" Focusable="False" />

                <StackPanel HorizontalAlignment="Center" Margin="0,120,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                    <Border Width="76" Height="76" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Sua cápsula do tempo está vazia" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,18,0,6"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                               Text="Cada mês em que você jogar ganha um resumo aqui: tempo, sessões e os jogos que marcaram o período." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Full month ============ -->
        <ContentControl Content="{Binding Detail}" Focusable="False" />
    </Grid>
</UserControl>
