<UserControl x:Class="GameTracker.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GameTracker.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GamesViewModel}"
             d:DesignWidth="1280" d:DesignHeight="760"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Game card: lifts on hover, accent frame. -->
        <Style x:Key="GameCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,22,26" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift" />
                            </Grid.RenderTransform>
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Button Style="{StaticResource GameCardButton}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <StackPanel Width="180">
                    <Grid Height="240">
                        <!-- Placeholder while there is no cover -->
                        <Border CornerRadius="12" Background="{Binding Name, Converter={StaticResource TitleBrush}}">
                            <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}" FontSize="44"
                                       Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource ImagePath}, ConverterParameter=360}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="Frame" CornerRadius="12" BorderThickness="2" BorderBrush="#14FFFFFF" />

                        <Border Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="10" CornerRadius="10" Background="#E60B0C10" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="JOGANDO" Margin="6,0,0,0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Name}" Margin="2,10,2,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" ToolTip="{Binding Name}" />
                    <Grid Margin="2,3,2,0">
                        <TextBlock Text="{Binding PlaytimeText}" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding SessionsText}" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ================= Library ================= -->
        <Grid Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="36,28,36,0">
                <StackPanel>
                    <TextBlock Text="Biblioteca" Style="{StaticResource TitleText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="{Binding SelectedPeriod.Label}" />
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Padding="14,7"
                        Background="{StaticResource SuccessSoftBrush}" Visibility="{Binding NowPlaying, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource SuccessBrush}" MaxWidth="420" TextTrimming="CharacterEllipsis">
                            <Run Text="Jogando agora:" FontWeight="SemiBold" /> <Run Text="{Binding NowPlaying, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1">
                <!-- Suggestions: games detected by behaviour, awaiting confirmation -->
                <Border Margin="36,22,36,0" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}"
                        Background="{StaticResource SurfaceBrush}" Padding="20,16"
                        Visibility="{Binding Suggestions, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82F;" Style="{StaticResource IconText}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Isso é um jogo?" Margin="10,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="Estes programas rodaram em tela cheia como um jogo. O tempo já está sendo registrado: confirme para incluí-los na biblioteca." />
                        <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SuggestionViewModel}">
                                    <Border Width="440" Margin="0,0,12,8" Padding="10" CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="48" Height="64">
                                                <Border CornerRadius="6" Background="{Binding Name, Converter={StaticResource TitleBrush}}" />
                                                <Border CornerRadius="6">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource ImagePath}, ConverterParameter=96}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0" Padding="6,4" HorizontalContentAlignment="Left"
                                                    ToolTip="Ver detalhes" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.OpenSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource TextDimBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding PlaytimeText}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PrimaryButton}" Content="É um jogo" Padding="12,6" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ConfirmSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Button Style="{StaticResource GhostButton}" Content="Não é" Padding="12,6" Margin="0,4,0,0" CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Center" ToolTip="Ignorar (pode ser desfeito nas Configurações)"
                                                        Command="{Binding DataContext.RejectSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Period statistics -->
                <ItemsControl Margin="36,22,20,0" ItemsSource="{Binding Stats}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StatItem}">
                            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="17"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Filters -->
            <Grid Grid.Row="2" Margin="36,22,36,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar jogo…  (Ctrl+F)"
                             Padding="34,8,12,8" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="13,0,0,0" IsHitTestVisible="False"
                               Foreground="{StaticResource TextDimBrush}" />
                </Grid>

                <Grid Grid.Column="1" Margin="12,0,0,0" Width="230">
                    <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Padding="0" ToolTip="Período">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PeriodOption}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,10,0"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="Label" Text="{Binding Label}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <ComboBox Grid.Column="2" Margin="12,0,0,0" Width="210" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="Label" ToolTip="Ordenar" />

                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding AddGameCommand}"
                        ToolTip="Adicione um executável que não foi detectado automaticamente">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Adicionar jogo" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Grid of games -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="36,6,14,20" Focusable="False">
                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCardTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty states -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60"
                        Visibility="{Binding IsLibraryEmpty, Converter={StaticResource VisibleWhen}}">
                <Border Width="76" Height="76" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource IconText}" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Nenhum jogo por aqui ainda" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,18,0,6"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                           Text="Abra qualquer jogo e ele aparecerá aqui automaticamente, com capa, detalhes e tempo de cada sessão." />
            </StackPanel>

            <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Style="{StaticResource MutedText}"
                       Text="Nenhum jogo encontrado para essa busca." Visibility="{Binding HasNoResults, Converter={StaticResource VisibleWhen}}" />
        </Grid>

        <!-- ================= Game page ================= -->
        <ContentControl Content="{Binding Detail}" Focusable="False" />
    </Grid>
</UserControl>
