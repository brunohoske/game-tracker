<UserControl x:Class="GameTracker.App.Views.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GameTracker.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameDetailViewModel}"
             d:DesignWidth="1280" d:DesignHeight="900">

    <UserControl.InputBindings>
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="340" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Hero artwork ============ -->
            <Grid ClipToBounds="True">
                <Rectangle Fill="{Binding Game.Name, Converter={StaticResource TitleBrush}}" />
                <Image Source="{Binding Game.BackgroundImagePath, Converter={StaticResource ImagePath}, ConverterParameter=1920}"
                       Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.55" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#660B0C10" />
                            <GradientStop Offset="0.55" Color="#B30B0C10" />
                            <GradientStop Offset="1" Color="{StaticResource BackgroundColor}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Button Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" Foreground="{StaticResource TextBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,22,0,0" ToolTip="Voltar (Alt+←)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Biblioteca" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ Body (pulled up so the title block overlaps the hero) ============ -->
            <StackPanel Grid.Row="1" Margin="40,-170,40,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover -->
                    <Grid Width="210" Height="280" VerticalAlignment="Top">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="Black" />
                        </Grid.Effect>
                        <Border CornerRadius="14" Background="{Binding Game.Name, Converter={StaticResource TitleBrush}}" />
                        <Border CornerRadius="14">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Game.CoverImagePath, Converter={StaticResource ImagePath}, ConverterParameter=420}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14" BorderThickness="1" BorderBrush="#1FFFFFFF" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="32,96,0,0">
                        <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Margin="0,0,0,10" Background="{StaticResource SuccessSoftBrush}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="JOGANDO AGORA" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Name (inline rename) -->
                        <Grid>
                            <TextBlock Text="{Binding Game.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="38" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}"
                                       Visibility="{Binding IsEditingName, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <TextBox x:Name="NameEditor" Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}" FontSize="22" MaxWidth="640"
                                     HorizontalAlignment="Left" MinWidth="360" IsVisibleChanged="OnNameEditorVisibleChanged"
                                     Visibility="{Binding IsEditingName, Converter={StaticResource VisibleWhen}}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>

                        <TextBlock Text="{Binding MetaLine}" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />

                        <ItemsControl ItemsSource="{Binding Game.Genres}" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Actions -->
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding BeginRenameCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Renomear" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshMetadataCommand}" Margin="0,0,8,8"
                                    ToolTip="Buscar capa e informações novamente">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Atualizar dados" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding CanOpenFolder, Converter={StaticResource VisibleWhen}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Abrir pasta" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding IgnoreCommand}" Margin="0,0,8,8"
                                    ToolTip="Parar de rastrear: não é um jogo">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED1A;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Não é um jogo" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Remover" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource SectionTitleText}" Margin="0,32,0,12">
                    <Run Text="ESTATÍSTICAS" /><Run Text="  ·  " Foreground="{StaticResource TextDimBrush}" /><Run Text="{Binding PeriodLabel, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,-14,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StatItem}">
                            <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding Label}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" Margin="0,8,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <!-- Monthly chart -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ÚLTIMOS 12 MESES" Style="{StaticResource SectionTitleText}" />
                                <ItemsControl ItemsSource="{Binding Months}" Height="150" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MonthBar}">
                                            <Grid ToolTip="{Binding Value}" Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" Margin="5,0" CornerRadius="5,5,2,2"
                                                        Background="{StaticResource AccentGradientBrush}" Opacity="0.35" />
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="11"
                                                           Foreground="{StaticResource TextDimBrush}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                                Visibility="{Binding Game.Summary, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="SOBRE" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding Game.Summary}" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                                Visibility="{Binding Game.InstallDirectory, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="INSTALAÇÃO" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding Game.InstallDirectory}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sessions -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="SESSÕES" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding SessionsCaption}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextDimBrush}" />
                            </Grid>

                            <TextBlock Text="Nenhuma sessão neste período." Style="{StaticResource MutedText}" Margin="0,4,0,4"
                                       Visibility="{Binding Sessions, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />

                            <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionRow}">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Date}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="Duration" Grid.Column="1" Text="{Binding Duration}" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter TargetName="Duration" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
